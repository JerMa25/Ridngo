{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://traefikdev.yowyob.com/ridngo",
        "EXPO_PUBLIC_VEHICLE_API_URL": "https://traefikdev.yowyob.com/vehicule"
      }
    },
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://traefikdev.yowyob.com/ridngo",
        "EXPO_PUBLIC_VEHICLE_API_URL": "https://traefikdev.yowyob.com/vehicule"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://traefikdev.yowyob.com/ridngo",
        "EXPO_PUBLIC_VEHICLE_API_URL": "https://traefikdev.yowyob.com/vehicule"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
